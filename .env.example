# UPI Payment Configuration
UPI_ID=7829039536@hdfc
UPI_NAME=The Bong Connection

# Protect the kitchen dashboard
ADMIN_KEY=replace-with-a-strong-admin-password

# SMS Gateway Configuration (For real mobile SMS delivery to customers)
# Option A: AWS SNS (Simple Notification Service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Option B: Fast2SMS (India): Register at https://www.fast2sms.com to get your API key
FAST2SMS_API_KEY=

# Option C: Twilio (Global):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Database
# Leave DATABASE_URL empty for local dev -> uses a local SQLite file (DB_PATH).
# Set DATABASE_URL to use AWS RDS Postgres instead (used automatically in production):
# DATABASE_URL=postgresql://bongadmin:YOUR_PASSWORD@YOUR-RDS-ENDPOINT:5432/bongconnection
DATABASE_URL=
DB_PATH=foodstall.db
